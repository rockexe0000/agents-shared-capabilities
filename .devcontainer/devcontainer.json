{
  "name": "agents-shared-capabilities",
  // Rust base image ships build-essential (cc/linker) + git, so `cargo build`/`test` for
  // tools-rs/ — the single `capsync` binary that is now all the capability tooling — work
  // out of the box.
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    // gh for opening PRs from inside the container.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // rustfmt/clippy back the tools-rs gate (cargo fmt --check / clippy -D warnings).
  "postCreateCommand": "rustup component add rustfmt clippy && cargo --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
